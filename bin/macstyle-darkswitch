#!/bin/sh
# MacStyle Ubuntu: GNOME automatic dark/light theme switcher.

set -u

s=org.gnome.desktop.interface
u=/org/gnome/shell/extensions/user-theme/name
b=/org/gnome/shell/extensions/blur-my-shell

apply() {
    if [ "$(gsettings get "$s" color-scheme)" = "'prefer-dark'" ]; then
        v=Dark
        g=WhiteSur-Dark-solid
        i=dark
        panel=2
        dock=2
    else
        v=Light
        g=WhiteSur-Light-soft
        i=light
        panel=0
        dock=1
    fi

    gsettings set "$s" gtk-theme "$g"
    gsettings set "$s" icon-theme "MacTahoe-$i"
    dconf write "$u" "'WhiteSur-$v'"
    dconf write "$b/panel/style-panel" "$panel"
    dconf write "$b/dash-to-dock/style-dash-to-dock" "$dock"
}

apply
gsettings monitor "$s" color-scheme | while read -r _; do
    apply
done
