# MacStyle Ubuntu GNOME 50 extension settings
# Preserved from the pre-configuration Ubuntu snapshot.

[org/gnome/shell/extensions/blur-my-shell]
settings-version=10

[org/gnome/shell/extensions/blur-my-shell/appfolder]
blur=true
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
blur-on-overview=false
corner-when-maximized=false
dynamic-opacity=false
enable-all=true
pipeline='pipeline_default'
static-blur=false
unblur-when-fullscreen=false

[org/gnome/shell/extensions/blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true
pipeline='pipeline_default'
style-dash-to-dock=2

[org/gnome/shell/extensions/blur-my-shell/lockscreen]
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/overview]
blur=true
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
pipeline='pipeline_default'
static-blur=true
style-panel=2

[org/gnome/shell/extensions/blur-my-shell/popup]
pipeline='pipeline_default'
screenshot-corner-radius=36

[org/gnome/shell/extensions/blur-my-shell/screenshot]
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/window-list]
pipeline='pipeline_default'

[org/gnome/shell/extensions/dash2dock-motion]
background-opacity=0.10000000000000001
dash-max-icon-size=46
dock-position='BOTTOM'
edge-distance=0
height-fraction=1.0
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
running-indicator-style='DOT'
show-icon-highlight=false
show-mounts=true
show-mounts-network=false
show-mounts-only-mounted=false

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark'

